root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj}]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
csharp_new_line_before_open_brace = all

[*.{ts,tsx,js,mjs,json,css,md,yml,yaml}]
indent_style = space
indent_size = 2

[**/Migrations/*.cs]
generated_code = true
